    Source: 'o5s/kernel/src/patch.rs', lines 17:0-34:1
    Visibility: public -/
def patch.merge
  (channel : alloc.vec.Vec Std.U64) (dependencies : alloc.vec.Vec Std.U64)
  (approved : Bool) (checks_passed : Bool) (patch_id : Std.U64) :
  Result (core.result.Result (alloc.vec.Vec Std.U64) patch.MergeError)
  := do
  if approved
  then
    if checks_passed
    then
      let b ←
        h5i_app_std.set.subset core.cmp.PartialEqU64 dependencies channel
      if b
      then
        let v ←
          h5i_app_std.set.insert core.cmp.PartialEqU64 core.clone.CloneU64
            channel patch_id
        ok (core.result.Result.Ok v)
      else ok (core.result.Result.Err patch.MergeError.MissingDependency)
    else ok (core.result.Result.Err patch.MergeError.ChecksFailed)
  else ok (core.result.Result.Err patch.MergeError.Unapproved)

