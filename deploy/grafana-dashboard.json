{
  "title": "pico2peta",
  "uid": "pico2peta-server",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "pico2peta"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      },
      {
        "name": "job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(p2p_http_requests_total, job)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "label": "Job"
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Requests/s by route",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (route) (rate(p2p_http_requests_total{job=~\"$job\"}[5m]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Errors/s (5xx) by route",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (route) (rate(p2p_http_requests_total{job=~\"$job\",status=~\"5..\"}[5m]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Latency p50 / p99 by route",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, route) (rate(p2p_http_request_duration_seconds_bucket{job=~\"$job\"}[5m])))",
          "legendFormat": "p50 {{route}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(p2p_http_request_duration_seconds_bucket{job=~\"$job\"}[5m])))",
          "legendFormat": "p99 {{route}}",
          "refId": "B"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "In flight",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(p2p_http_in_flight{job=~\"$job\"})",
          "legendFormat": "in flight",
          "refId": "A"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Object bytes/s",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(p2p_object_bytes_uploaded_total{job=~\"$job\"}[5m]))",
          "legendFormat": "uploaded",
          "refId": "A"
        },
        {
          "expr": "sum(rate(p2p_object_bytes_downloaded_total{job=~\"$job\"}[5m]))",
          "legendFormat": "downloaded",
          "refId": "B"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Name updates (OCC) by outcome",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(p2p_replace_total{job=~\"$job\"}[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Auth failures / authz denials / rate limited",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(p2p_auth_failures_total{job=~\"$job\"}[5m]))",
          "legendFormat": "auth {{outcome}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(p2p_authz_denied_total{job=~\"$job\"}[5m]))",
          "legendFormat": "authz denied",
          "refId": "B"
        },
        {
          "expr": "sum(rate(p2p_rate_limited_total{job=~\"$job\"}[5m]))",
          "legendFormat": "rate limited",
          "refId": "C"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Audit write failures (mutations are refused while > 0)",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(p2p_audit_write_failures_total{job=~\"$job\"}[15m]))",
          "legendFormat": "failures",
          "refId": "A"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "GC runs and deleted bytes",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (outcome) (increase(p2p_gc_runs_total{job=~\"$job\"}[1h]))",
          "legendFormat": "runs {{outcome}}",
          "refId": "A"
        },
        {
          "expr": "sum(increase(p2p_gc_deleted_bytes_total{job=~\"$job\"}[1h]))",
          "legendFormat": "deleted bytes / h",
          "refId": "B"
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Proxy-cache upstream fetches by front",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (front) (rate(p2p_upstream_fetches_total{job=~\"$job\"}[5m]))",
          "legendFormat": "{{front}}",
          "refId": "A"
        }
      ],
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "S3 requests / retries / throttled / failures",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(p2p_s3_requests_total{job=~\"$job\"}[5m]))",
          "legendFormat": "requests",
          "refId": "A"
        },
        {
          "expr": "sum(rate(p2p_s3_retries_total{job=~\"$job\"}[5m]))",
          "legendFormat": "retries",
          "refId": "B"
        },
        {
          "expr": "sum(rate(p2p_s3_throttled_total{job=~\"$job\"}[5m]))",
          "legendFormat": "throttled",
          "refId": "C"
        },
        {
          "expr": "sum(rate(p2p_s3_failures_total{job=~\"$job\"}[5m]))",
          "legendFormat": "failures",
          "refId": "D"
        }
      ],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "S3 bytes/s",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(p2p_s3_bytes_sent_total{job=~\"$job\"}[5m]))",
          "legendFormat": "sent",
          "refId": "A"
        },
        {
          "expr": "sum(rate(p2p_s3_bytes_received_total{job=~\"$job\"}[5m]))",
          "legendFormat": "received",
          "refId": "B"
        }
      ],
      "id": 12
    }
  ]
}