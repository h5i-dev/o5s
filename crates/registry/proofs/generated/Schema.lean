  have := usize_max_le
  unfold Approval.to_row; step* <;> simp_all [Approval.row] <;> scalar_tac

theorem Approval.row_inj : Function.Injective Approval.row := by
  intro a b h; cases a; cases b; simp_all [Approval.row]

