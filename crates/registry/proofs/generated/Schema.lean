    Event.from_rows rows ⦃ o => ∃ v, o = some v ∧ v.val = l ⦄ := by
  have e : Event.from_rows_loop rows (alloc.vec.Vec.new Event) true 0#usize =
      loop (fun x => rowsBody Event.from_row rows x.1 x.2.1 x.2.2) (alloc.vec.Vec.new Event, true, 0#usize) := by
    unfold Event.from_rows_loop; congr 1; funext ⟨a, b, c⟩
    simp only []; unfold Event.from_rows_loop.body rowsBody
    dsimp only
    split <;> (try rfl)
    congr 1; funext v; congr 1; funext o; cases o <;> rfl
  have hl : Event.from_rows_loop rows (alloc.vec.Vec.new Event) true 0#usize ⦃ r => r.2 = true ∧ r.1.val = l ⦄ := by
    rw [e]; exact rows_loop Event.from_row Event.row (fun x v hv => Event.from_row_spec x v hv) rows l h
  unfold Event.from_rows
  step with hl
  simp [ok1_post, l_post]

