  simp [Approval.Insts.CoreCloneClone.clone, lift]

@[step] theorem Approval.clone_spec (x : Approval) : Approval.Insts.CoreCloneClone.clone x ⦃ y => y = x ⦄ := by
  rw [Approval.clone_eq]; simp

def Approval.putA (x : Approval) : AWrite Val := .put Approval.table Approval.keyLen (Approval.row x)

@[step] theorem Approval.sql_put_spec (x : Approval) : Approval.sql_put x ⦃ w => sqlW w = Approval.putA x ⦄ := by
  unfold Approval.sql_put; step*; simp_all [sqlW, Approval.putA, Approval.table, Approval.keyLen, Approval.TABLE, Approval.KEY_LEN]

/-- Insert, or replace the row with the same key. -/
@[step] theorem Approval.put_spec (v : alloc.vec.Vec Approval) (x : Approval) (h : v.length < Usize.max) :
    Approval.put v x ⦃ v' => v'.val = upsert (fun y => (y.patch, y.reviewer)) x v.val ⦄ := by
  unfold Approval.put Approval.put_loop
  apply WP.spec_mono (loop_search v.val (fun q => decide ((q.patch, q.reviewer) = (x.patch, x.reviewer)))
    (fun y : alloc.vec.Vec Approval => y.val) (fun j _ => v.val.set j x) (v.val ++ [x]) _ ?_ 0#usize (by simp))
  · intro r hr; rw [hr, show ((0#usize : Usize) : Nat) = 0 from rfl]
    exact upsert_loop_result (fun y => (y.patch, y.reviewer)) x _ 0 (Nat.zero_le _) (by simp)
  · intro j hj; unfold Approval.put_loop.body; h5i_step

/-- The rows without this key. -/
@[step] theorem Approval.del_spec (v : alloc.vec.Vec Approval) (patch : U64) (reviewer : U64) :
    Approval.del v patch reviewer ⦃ v' => v'.val = v.val.filter (fun y => ¬(y.patch = patch ∧ y.reviewer = reviewer)) ⦄ := by
  unfold Approval.del Approval.del_loop
  apply WP.spec_mono (loop_fold v.val (fun w : alloc.vec.Vec Approval => w.val)
    (fun acc y => if decide ¬(y.patch = patch ∧ y.reviewer = reviewer) then acc ++ [y] else acc)
    (fun w j => w.length ≤ j) (fun x => Approval.del_loop.body v patch reviewer x.1 x.2) ?_ _ 0#usize (by simp) (by simp))
  · intro r hr; rw [hr, foldl_filter]; simp
  · intro o j hj ho; have := v.len_ineq; unfold Approval.del_loop.body; h5i_step

/-- The rows whose column `col` does not hold `val`. -/
@[step] theorem Approval.del_where_spec (v : alloc.vec.Vec Approval) (col : U32) (val : Val) :
    Approval.del_where v col val ⦃ v' => v'.val = v.val.filter (fun y => ¬((Approval.row y)[col.val]? = some val)) ⦄ := by
  unfold Approval.del_where Approval.del_where_loop
  apply WP.spec_mono (loop_fold v.val (fun w : alloc.vec.Vec Approval => w.val)
    (fun acc y => if decide ¬((Approval.row y)[col.val]? = some val) then acc ++ [y] else acc)
    (fun w j => w.length ≤ j) (fun x => Approval.del_where_loop.body v col val x.1 x.2) ?_ _ 0#usize (by simp) (by simp))
  · intro r hr; rw [hr, foldl_filter]; simp
  · intro o j hj ho; have := v.len_ineq; unfold Approval.del_where_loop.body; h5i_step

