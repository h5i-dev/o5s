    upsert (·.take 2) (Approval.row x) (l.map Approval.row) = (upsert (fun y => (y.patch, y.reviewer)) x l).map Approval.row :=
  map_upsert _ _ _ _ _ (fun y => by simp [Approval.row])

@[simp] theorem Approval.map_del (patch : U64) (reviewer : U64) (l : List Approval) :
    (l.map Approval.row).filter (fun r => !decide (r.take 2 = [int patch.val, int reviewer.val])) =
