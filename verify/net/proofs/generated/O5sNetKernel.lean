def parse.lfs_line
  (sc : parse.LfsScan) (body : Slice Std.U8) (start : Std.Usize)
  («end» : Std.Usize) :
  Result parse.LfsScan
  := do
  let oid_p ←
    lift (Array.to_slice
      (Array.make 11#usize [
        111#u8, 105#u8, 100#u8, 32#u8, 115#u8, 104#u8, 97#u8, 50#u8, 53#u8,
        54#u8, 58#u8
