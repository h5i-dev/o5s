    let i1 ← «end» - vs
    if i1 = 64#usize
    then
      let b1 ← parse.all_hex body vs «end»
      if b1
      then ok { sc with has_oid := true, oid_s := vs, oid_e := «end» }
      else ok sc
    else ok sc
  else
    let b1 ← parse.starts_at body start «end» size_p
    if b1
    then
      let i := Slice.len size_p
      let i1 ← start + i
      let v ← parse.slice_of body i1 «end»
      let s := alloc.vec.Vec.deref v
      let o ← parse.parse_dec_u64 s
