    match m with
    | Mobility.Mutable =>
      let last ← refs.last_version t.current t.tombstone
      if last = core.num.U64.MAX
      then ok (core.result.Result.Err (refs.Refusal.VersionExhausted i))
      else
        let version ← last + 1#u64
        ok (core.result.Result.Ok (refs.Effect.Set { hash := h, version }))
    | Mobility.CreateOnce =>
      let b := core.option.Option.is_some t.current
      if b
      then
        ok (core.result.Result.Err (refs.Refusal.Forbidden i rule
          Why.Published))
      else
