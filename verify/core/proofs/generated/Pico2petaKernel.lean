        ok (core.result.Result.Err (refs.Refusal.Forbidden i rule
          Why.ImmutableDelete))
      | Mobility.Forbidden =>
        ok (core.result.Result.Err (refs.Refusal.Forbidden i rule
          Why.HeadReleaseOnly))
